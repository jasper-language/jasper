// In-memory `ResultSet` implementation, deliberately split out of
// `MemoryJdbc.jas` into its own file.
//
// This split is the regression guard for cross-file interface subtyping
// (FINDINGS #7): `implements ResultSet` is declared here while the
// interface-typed assignment (`var rs: ResultSet = st.executeQuery(...)`) lives
// in `MemoryJdbc.jas`. The previous workaround kept every concrete class in the
// same file as the assignment because the checker recorded `implements` per
// source file.
package std;

public class MemoryResultSet implements ResultSet {
    private var intCells: int32[];
    private var strCells: string[];
    private var nullCells: bool[];
    private var colCount: int32;
    private var rowCount: int32;
    private var cursor: int32;
    private var lastNull: bool;

    public constructor(intCells: int32[], strCells: string[], nullCells: bool[], colCount: int32, rowCount: int32) {
        this.intCells = intCells;
        this.strCells = strCells;
        this.nullCells = nullCells;
        this.colCount = colCount;
        this.rowCount = rowCount;
        this.cursor = 0 - 1;
        this.lastNull = false;
    }

    public function next(): bool {
        this.cursor = this.cursor + 1;
        return this.cursor < this.rowCount;
    }

    // A real driver keeps a private `cellIndex(col)` helper; the flat-index
    // arithmetic is inlined here because `this.method()` was not callable when
    // the probe was written (see FINDINGS #4).
    public function getInt(col: int32): int32 {
        var i: int32 = this.cursor * this.colCount + col;
        var isNull: bool = this.nullCells[i];
        this.lastNull = isNull;
        return this.intCells[i];
    }

    public function getString(col: int32): string {
        var i: int32 = this.cursor * this.colCount + col;
        var isNull: bool = this.nullCells[i];
        this.lastNull = isNull;
        return this.strCells[i];
    }

    // A real driver maps a column label to an index through a per-statement
    // label table. Jasper has no working generic map today (`dict<K,V>` as a
    // *type* maps to a non-existent class), so this fake only supports the
    // second column. See FINDINGS.md, finding "dict<K,V> 不能作类型".
    public function getStringByLabel(columnName: string): string {
        var i: int32 = this.cursor * this.colCount + 1;
        var isNull: bool = this.nullCells[i];
        this.lastNull = isNull;
        return this.strCells[i];
    }

    public function wasNull(): bool {
        return this.lastNull;
    }

    public function close(): void { }
}
