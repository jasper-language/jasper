package std;

// =============================================================================
// ProbeApi.jas —— 探针专用注解类型
// =============================================================================
// 做什么：定义一个只有一个 `value()` 元素的注解类型，用来验证「注解可以标注
//   R2DBC 形状的接口」这一压力点（与 JDBC 探针同款）。
// 什么时候用：编译期扫描 `@ProbeApi(...)`；本探针只声明不读取其值。
// 为什么放在 std：与 JDBC 探针保持一致——探针 API 与标准库同包，便于复用 std.Error。
// =============================================================================
@interface ProbeApi {
    public string value() default "";
}
