// =============================================================================
// MemoryResultSet.jas —— ResultSet 的内存实现（独立文件）
// =============================================================================
// 做什么：把一个 Row[] 包装成前向游标，逐列读取，并维护 wasNull 侧信道。
// 什么时候用：由 main 直接构造，演示「执行与逐行读取」形状；也用于验证
//   「接口实现类与接口类型赋值点分处不同文件」仍然成立。
//
// 为什么独立成文件：对齐 JDBC 探针的 MemoryResultSet 拆分——跨文件接口实现
//   曾经不可用（FINDINGS #7 已修复），这里保留拆分作为回归守门：
//   `implements ResultSet` 在本文件，而 `var rs: ResultSet = ...` 在
//   MemoryR2dbc.jas。
//
// 实现说明：真实驱动用私有 `cellIndex(col)` 助手；这里直接内联下标，保持简单。
// =============================================================================
package std;

public class MemoryResultSet implements ResultSet {
    private var rows: Row[];
    private var cursor: int32;
    private var lastNull: bool;

    public constructor(rows: Row[]) {
        this.rows = rows;
        this.cursor = 0 - 1;
        this.lastNull = false;
    }

    public function next(): bool {
        this.cursor = this.cursor + 1;
        return this.cursor < this.rows.length;
    }

    public function getInt(col: int32): int32 {
        // 先把数组元素读进显式类型的局部变量，再访问字段：直接对数组读做成员
        // 访问会踩到数组读表达式的类型推断问题（见 FINDINGS #11）。
        var row: Row = this.rows[this.cursor];
        this.lastNull = false;
        return row.id();
    }

    public function getString(col: int32): string {
        var row: Row = this.rows[this.cursor];
        this.lastNull = false;
        return row.name();
    }

    public function wasNull(): bool {
        return this.lastNull;
    }

    public function close(): void { }
}
