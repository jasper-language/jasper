// spec: 02-字面量.md#2.1 整数字面量
// kind: pos
// expect: exit 329
// 多种进制与下划线分隔符都应产生相同的数值语义。
package test;

public function main(): int32 {
    var hex: int32 = 0xFF;
    var octal: int32 = 0o77;
    var binary: int32 = 0b1010;
    var grouped: int32 = 1_000_000;
    return hex + octal + binary + (grouped - 1_000_000) + 1;
}
