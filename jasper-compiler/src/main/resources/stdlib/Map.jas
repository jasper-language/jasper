package std;

// ============================================================================
// Map.jas —— Jasper 标准库的最小可变键值映射接口
// ============================================================================
// 职责：
//   声明语言内建 `Map<K,V>` 的成员面。`dict<K,V>` 是它的具体实现，JVM 后端把
//   Map 映射到 java.util.Map、把 dict 映射到 java.util.HashMap。
//
// 设计边界（变化点）：
//   v1 不设 MutableMap：Map 本身就是可变接口，读写权限由语言机制管理。把
//   「键类型/值类型」固定为 K/V 后，检查器可以校验 get/put/containsKey 的实参
//   并推断 get/put 的返回类型，而不是退化成 any。
//
// 为什么保留最小面：
//   只公开 size/get/containsKey/put/remove 这些能被内建集合元数据完整校验的
//   操作；entrySet/keySet/values 等视图涉及额外容器类型，留待后续标准库步骤。
// ============================================================================

/**
 * 从键到值的映射。
 *
 * 什么时候用：需要使用非连续键索引值，且需要显式查询键是否存在时。
 * 前置条件：K 是键的静态类型，V 是值的静态类型；具体实现必须提供一致的
 *   equals/hashCode 语义。
 * 失败模式：null 键/值的支持由实现决定（默认 HashMap 接受 null）；size/get/
 *   put 本身不抛业务异常。
 * 为什么 Map 是可变接口：语言约定不给 Map 再分只读/可变两层；只读视图可由
 *   调用方约定，而不是增加一个类型参数相同的 MutableMap。
 */
public interface Map<K, V> {
    /**
     * 做什么：返回映射中键值对的数量。
     * 什么时候用：判断空映射或遍历边界时。
     * 前置条件：无。
     * 失败模式：不会失败；空映射返回 0。
     */
    public function size(): int32;

    /**
     * 做什么：返回 key 关联的值；键不存在时返回 null。
     * 什么时候用：已知键且能接受缺失结果为 null 时。
     * 前置条件：key 与 K 类型兼容。
     * 失败模式：键不存在时返回 null（V 为基本类型时调用方应先用 containsKey）。
     * 为什么返回 V 而不是 V?：语言 v1 的泛型可空表达仍以显式 V? 书写为准；
     *   本接口保持 JDK 兼容的「缺失返回 null」行为，由调用方决定是否判空。
     */
    public function get(key: K): V;

    /**
     * 做什么：判断映射中是否存在 key。
     * 什么时候用：需要在 get 之前区分「缺失」与「值为 null」时。
     * 前置条件：key 与 K 类型兼容。
     * 失败模式：不会失败；不存在返回 false。
     */
    public function containsKey(key: K): bool;

    /**
     * 做什么：把 key 关联到 value，并返回该键之前关联的旧值（没有则返回 null）。
     * 什么时候用：插入或更新映射条目时。
     * 前置条件：key/value 分别与 K/V 类型兼容。
     * 失败模式：实现拒绝修改时可能抛 UnsupportedOperationException；默认
     *   HashMap 实现不会拒绝。
     */
    public function put(key: K, value: V): V;

    /**
     * 做什么：移除 key 对应的条目，并返回被移除的旧值（没有则返回 null）。
     * 什么时候用：删除映射条目且需要旧值时。
     * 前置条件：key 与 K 类型兼容。
     * 失败模式：键不存在时返回 null；不抛异常。
     */
    public function remove(key: K): V;
}
