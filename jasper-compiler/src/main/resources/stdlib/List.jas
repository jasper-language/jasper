package std;

// ============================================================================
// List.jas —— Jasper 标准库的最小只读序列接口
// ============================================================================
// 职责：
//   声明语言内建 `List<T>` 的只读成员面。JVM 后端把该类型映射到
//   java.util.List，本文件负责让源码层的类型声明、成员签名与文档保持一致。
//
// 设计边界（变化点）：
//   只读与可变能力由 List / MutableList 两个接口分开表达；需要 add/set/remove
//   的程序应使用 MutableList<T>，而不是在 List<T> 上偷偷暴露可变操作。
//
// 为什么保留最小面：
//   v1 只承诺 size/get/contains 三个可被语言元数据完整校验的操作。更大的 JDK
//   方法面（sort/replaceAll/stream 等）需要逐个确认泛型与异常语义，暂不公开。
// ============================================================================

/**
 * 有序、可按下标读取的序列视图。
 *
 * 什么时候用：函数只需要读取元素个数或按下标取元素时，用 List<T> 表达
 *   「不修改调用方容器」的契约。
 * 前置条件：T 是元素的静态类型；实现可以是 ArrayList 或其他 JDK List。
 * 失败模式：size/get 的越界行为由 JVM 实现抛 IndexOutOfBoundsException；
 *   Jasper 不在此接口内吞掉异常。
 * 为什么只读：与语言约定保持一致，避免「拿到 List 参数却意外修改调用方数据」。
 */
public interface List<T> {
    /**
     * 做什么：返回序列中元素的数量。
     * 什么时候用：需要遍历边界或判断空序列时；空序列返回 0。
     * 前置条件：无。
     * 失败模式：不会失败。
     */
    public function size(): int32;

    /**
     * 做什么：返回下标 index 处的元素（0 基）。
     * 什么时候用：已知下标且需要读取单个元素时。
     * 前置条件：0 <= index < size()。
     * 失败模式：下标越界时由底层 JVM List 抛 IndexOutOfBoundsException。
     */
    public function get(index: int32): T;

    /**
     * 做什么：判断序列是否包含与 value 相等的元素。
     * 什么时候用：只读查找，不关心元素下标时。
     * 前置条件：value 与 T 类型兼容；相等语义由元素自身的 equals 决定。
     * 失败模式：不会因未找到而失败，未找到返回 false。
     */
    public function contains(value: T): bool;
}
