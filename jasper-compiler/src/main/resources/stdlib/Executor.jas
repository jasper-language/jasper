package std;

// ============================================================================
// Executor.jas —— 任务调度端口
// ============================================================================
// 职责：
//   隔离「任务在哪里执行」这一变化点。TaskGroup 只依赖本接口把 Runnable 交给
//   某个执行器；具体线程池、单线程事件循环或未来 Jasper OS 调度器由实现提供。
//
// 依赖方向：
//   Executor -> Runnable（单向）。TaskGroup -> Executor；Executor 不知道 TaskGroup，
//   因此不会形成运行时状态机之间的环。
//
// 为什么只有两个方法：
//   schedule 表达「提交」；shutdown 表达「不再接收新任务」。取消、完成通知与父子
//   回收由 Future/TaskGroup 负责，不塞进执行器端口，避免端口变成上帝接口。
// ============================================================================

/**
 * 做什么：接收并安排可运行任务。
 *
 * 什么时候用：TaskGroup.spawn 在登记子任务后，把 TaskRunner 交给执行器。
 * 前置条件：实现必须保证 schedule 返回前任务已被接受或明确拒绝；拒绝应抛异常。
 * 失败模式：实现可以在关闭后抛平台异常（例如 RejectedExecutionException）；
 *   调用方负责把拒绝转换成 Future 失败并完成回收。
 * 为什么这样设计：只暴露提交和关闭两个能力，使 JVM 线程池、单线程队列和未来
 *   的 OS 调度器都能实现同一端口。
 */
public interface Executor {
    /**
     * 做什么：把一个 Runnable 提交给执行器。
     * 什么时候用：任务创建完成后立即调用一次。
     * 前置条件：task 非 null；调用方已完成作用域登记。
     * 失败模式：执行器关闭或资源耗尽时抛异常；不保证同步执行。
     */
    public function schedule(task: Runnable): void;

    /**
     * 做什么：请求执行器停止接收新任务，并释放底层资源。
     * 什么时候用：调用方不再需要提交任务时；已经提交的任务是否继续执行由实现说明。
     * 前置条件：无；重复调用应保持幂等。
     * 失败模式：平台实现可能在关闭时抛异常；本接口不吞掉实现异常。
     */
    public function shutdown(): void;
}
