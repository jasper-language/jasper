package std;

// ============================================================================
// CoroutineTask.jas —— 生成协程帧进入结构化作用域的内部协议
// ============================================================================
// 职责：
//   让编译器生成的协程帧（S4-C）作为 TaskGroup 的子任务启动。帧自身是回调驱动的
//   状态机，不能像 TaskBody 那样在一个工作线程上同步返回结果；作用域只需要拿到
//   帧已绑定的结果 Future 进行登记，再请求首次恢复。
//
// 协作方：
//   - TaskGroup.launch：登记结果 Future → 挂接失败级联 → bindToken → start；
//   - 编译器生成帧：构造时把结果 Future 绑定到 ContinuationDispatch，start 时
//     同时订阅自身结果 Future，作用域取消该 Future 后帧会被唤醒并在调度门内回收。
//
// 边界：
//   这是运行时内部协议，不是公开的源码挂起调用 ABI，也不是显式挂起标记；
//   源码层如何调用挂起函数仍待裁决。
// ============================================================================

/**
 * 可由结构化作用域启动的协程帧。
 *
 * 做什么：暴露帧独占的结果 Future，并提供只请求首次恢复的 start。
 * 什么时候用：TaskGroup.launch 的参数；编译器生成帧实现本接口。
 * 前置条件：resultFuture 在构造时已绑定且尚未 start；同一帧只交给一个作用域一次。
 * 失败模式：start 遇执行器拒绝时抛出原平台异常，帧已为绑定结果发布 schedule 失败并标记 settled。
 * 为什么不复用 TaskBody：TaskBody.run 在一个线程上同步得到结果，而生成帧在挂起点
 *   注册回调后立即返回线程，结果由后续恢复段发布；两者生命周期模型不同。
 */
public interface CoroutineTask<T> {
    /**
     * 做什么：返回帧发布终态并标记 settled 的结果 Future。
     * 什么时候用：TaskGroup.launch 登记子任务时。
     * 前置条件：无；每次返回同一个对象。
     * 失败模式：不会失败。
     */
    public function resultFuture(): Future<T>;

    /**
     * 做什么：交给帧一个属于作用域的取消令牌；帧在每趟分派与每个挂起点入口用它检查截止时间，
     *   检查发现令牌已取消（作用域或自身到期、作用域取消）时以令牌的首个原因取消自己的结果。
     * 什么时候用：TaskGroup.launch 在 start 之前调用一次。
     * 前置条件：尚未 start；token 非 null。不经作用域启动的帧使用构造时自带的无期限令牌。
     * 失败模式：不会失败。
     * 为什么由作用域给令牌而不是帧自己创建：截止点与取消原因都属于作用域；子令牌挂在根令牌下，
     *   帧的检查点才能观察作用域截止点，并帮助传播作用域的取消。
     */
    public function bindToken(token: CancellationToken): void;

    /**
     * 做什么：请求帧的第一次恢复；真正执行在执行器线程上发生。
     * 什么时候用：作用域完成登记之后调用一次。
     * 前置条件：结果 Future 已登记到作用域（若由作用域启动）。
     * 失败模式：执行器拒绝时抛平台异常，结果 Future 已是 Failed 且已 settled。
     */
    public function start(): void;
}
