package std;

// ============================================================================
// TaskGroup.jas —— 单层结构化并发作用域
// ============================================================================
// 职责：
//   持有同一作用域内创建的全部子任务，提供 spawn/close、普通组失败级联取消与
//   监督组的 B 策略失败聚合。子任务的生命周期只有一层：不在此文件实现嵌套作用域，
//   以免把父子注册表扩张成难以审计的树。
//
// 失败传播（已裁决语义）：
//   - 普通组：首个业务失败立即取消其余未终止子任务，close 仍等待全部执行体退出；
//   - 监督组：子失败不取消兄弟；
//   - B 策略：supervisor 作用域退出时，已由调用方 acknowledgeFailure 确认的失败
//     不进入聚合；未确认失败必须聚合。普通组不受确认影响，仍以最早创建的失败为
//     primary 并保留其余为 suppressed 计数。
//
// 截止点（S4 契约 §2 / §4）：
//   作用域截止点保存在根令牌上（restrictDeadline 只能收紧）；spawnWithDeadline 给单个子任务
//   更严格的期限，子有效截止点 = min(作用域, 显式)；launchWithDeadline 对生成帧同理。到期只在
//   检查点观察：任务体开始前、任务体调用 throwIfCancelled 时、launch 登记帧时、生成帧每趟分派
//   与每个挂起点入口。作用域到期取消根令牌（全部子任务得到 Deadline 原因，close 报 Deadline）；
//   子任务自身期限到期只取消该子任务。到期不是业务失败，不触发普通组的兄弟级联。
//   每个生成帧持有根令牌的子令牌，令牌取消经 ScopeCancellationRelay 以首个原因取消帧的结果
//   Future——任何检查点观察到的作用域到期都会唤醒挂起中的帧。计时唤醒（无检查点时到期）
//   留给后续切片。
//
// 依赖方向：
//   TaskGroup -> Executor / Future / CancellationToken；这些下层不知道 TaskGroup，
//   因此运行时模块之间没有环。
//
// 关键不变量：
//   1) close 先封闭新增入口，再等待所有已登记任务体 markTaskSettled；
//   2) 聚合结果在第一次 close 时冻结，之后确认失败不会反向修改这次聚合；
//   3) 调度拒绝必须转换成 Future 失败并完成 settled 标记，不能留下永远 Pending 的任务。
//
// 变化点隔离：
//   - 普通/监督差异集中在 onChildFailure 与 aggregate 两个方法；
//   - 具体线程池由 Executor 端口隔离，本文件不出现 Executors 等平台类型。
// ============================================================================

/**
 * 子任务执行体。
 *
 * 做什么：把「业务计算」与「任务包装/状态机」分开，执行体只接收取消令牌并返回 T。
 * 什么时候用：TaskGroup.spawn 的第二个参数。
 * 前置条件：实现应在长循环/阻塞前检查 token.isCancelled()。
 * 失败模式：抛出的业务异常会被包装成 Future 失败；平台异常也会被记录。
 * 为什么接收令牌：取消是协作式的，执行体没有令牌就无法在安全点退出。
 */
public interface TaskBody<T> {
    /**
     * 做什么：执行一次子任务并返回结果。
     * 什么时候用：TaskRunner 在调度线程上调用。
     * 前置条件：token 由作用域派生，调用方不应替换。
     * 失败模式：抛 Error 表示业务失败，抛其他 Throwable 表示平台失败。
     */
    public function run(token: CancellationToken): T;
}

/**
 * 作用域因未处理失败退出时抛出的聚合错误。
 *
 * 做什么：携带 primary 失败消息与 suppressed 数量，保证多个失败不会静默丢失。
 * 什么时候用：TaskGroup.close 发现需要聚合的失败时。
 * 前置条件：至少一个失败未被排除。
 * 失败模式：不会失败。
 * 为什么是 Error 子类：错误是控制流载体，不进入普通返回值。
 */
public class TaskGroupFailure extends Error {
    private var suppressedTotal: int32;

    /**
     * 做什么：构造聚合错误。
     * 什么时候用：close 计算完 primary 与 suppressed 后。
     * 前置条件：message 非 null，suppressedTotal 非负。
     * 失败模式：不会失败。
     * 为什么保存数量：完整 Failure 列表若作为 Error 字段会违反「错误不是值」，
     *   数量加 primary 消息足以让调用方定位并保留可观察的聚合规模。
     */
    public constructor(message: string, suppressedTotal: int32) {
        super(message);
        this.suppressedTotal = suppressedTotal;
    }

    /** 做什么：返回被压制的失败数量。前置条件：无；失败模式：不会失败。 */
    public function suppressedCount(): int32 {
        return this.suppressedTotal;
    }
}

/**
 * 关闭后继续 spawn 时抛出的结构化错误。
 *
 * 做什么：明确拒绝「作用域关闭后新增子任务」，而不是静默返回一个不会被 join 的 Future。
 * 什么时候用：TaskGroup.isClosed 为真时调用 spawn。
 * 前置条件：作用域已进入关闭流程。
 * 失败模式：不会失败。
 * 为什么直接抛错：创建失败不能留下无法回收的活动子任务。
 */
public class TaskGroupClosedError extends Error {
    /** 做什么：构造关闭错误。前置条件：message 非 null；失败模式：不会失败。 */
    public constructor(message: string) {
        super(message);
    }
}

/**
 * 单层结构化并发作用域。
 *
 * 做什么：登记子任务、传递取消、在 close 时 join 并聚合未处理失败。
 * 什么时候用：需要把一组子任务绑定到同一生命周期时；测试与平台边界也用它。
 * 前置条件：执行器由调用方提供并负责最终 shutdown；同一个 TaskGroup 只应被一个
 *   协调线程驱动 spawn/close（内部锁只保证登记原子性，不承诺并发 spawn 的公平顺序）。
 * 失败模式：close 抛 TaskGroupFailure 表示未处理失败，仅有取消则抛 CancellationException；spawn 在关闭后抛
 *   TaskGroupClosedError；执行器拒绝调度时返回失败的 Future 而不遗留活动任务。
 * 为什么这样设计：Future 管单任务状态，TaskGroup 只管父子关系与聚合，职责分开后
 *   两者都不需要知道对方内部状态机的细节。
 */
public class TaskGroup {
    private var supervisorScope: bool;
    private var closed: bool;
    private var mutex: java.util.concurrent.Semaphore;
    private var rootToken: CancellationToken;
    private var children: MutableList<Future<any>>;
    private var aggregationDone: bool;
    private var aggregatePrimary: Failure?;
    private var aggregateSuppressed: int32;
    private var aggregateCancelled: bool;
    private var aggregateReason: CancellationReason;

    /**
     * 做什么：创建普通组或监督组。
     * 什么时候用：进入结构化并发作用域时。
     * 前置条件：supervisorScope 为 true 表示 B 策略监督组。
     * 失败模式：信号量分配失败时以平台异常出现。
     * 为什么用布尔而不是两个类：两种作用域只差失败传播两处，合并可避免复制 join 逻辑。
     */
    public constructor(supervisorScope: bool) {
        this.supervisorScope = supervisorScope;
        this.closed = false;
        this.mutex = new java.util.concurrent.Semaphore(1);
        this.rootToken = new CancellationToken();
        this.children = new MutableList<Future<any>>();
        this.aggregationDone = false;
        this.aggregatePrimary = null;
        this.aggregateSuppressed = 0;
        this.aggregateCancelled = false;
        this.aggregateReason = CancellationReason.Explicit;
    }

    /** 做什么：判断是否监督组。前置条件：无；失败模式：不会失败。 */
    public function isSupervisor(): bool {
        return this.supervisorScope;
    }

    /** 做什么：判断是否已关闭新增入口。前置条件：无；失败模式：不会失败。 */
    public function isClosed(): bool {
        this.mutex.acquireUninterruptibly();
        var result: bool = this.closed;
        this.mutex.release();
        return result;
    }

    /**
     * 做什么：创建并调度一个子任务。
     * 什么时候用：作用域尚未关闭时。
     * 前置条件：executor 与 body 非 null。
     * 失败模式：关闭后抛 TaskGroupClosedError；调度异常转成失败 Future 并立即标记
     *   执行体已结束，避免 close 永久等待。
     * 为什么先登记再调度：close 可能并发发生；先登记能让 close 看到这个 Future 并
     *   等待它，随后调度一定会为它发布终态或失败。
     */
    public function spawn<T>(executor: Executor, body: TaskBody<T>): Future<T> {
        return this.spawnWithin(executor, body, null);
    }

    /**
     * 做什么：创建并调度一个带显式截止点的子任务；有效截止点 = min(作用域截止点, deadline)。
     * 什么时候用：某个子任务需要比作用域更严格的期限时（契约 §6 ChildOptions.deadline）。
     * 前置条件：同 spawn；deadline 非 null。
     * 失败模式：同 spawn；到期时任务体在检查点观察到 Deadline 取消，结果为 Cancelled(Deadline)。
     * 为什么显式期限不能放宽：子令牌只能收紧，晚于作用域的 deadline 不起作用（子不能延长父期限）。
     */
    public function spawnWithDeadline<T>(executor: Executor, body: TaskBody<T>, deadline: Deadline): Future<T> {
        return this.spawnWithin(executor, body, deadline);
    }

    /**
     * 做什么：spawn / spawnWithDeadline 的共同实现；deadline 为 null 表示只继承作用域截止点。
     * 前置条件 / 失败模式：同 spawn。
     * 为什么公开：Jasper 当前没有包内可见性；调用方应使用 spawn / spawnWithDeadline。
     */
    public function spawnWithin<T>(executor: Executor, body: TaskBody<T>, deadline: Deadline?): Future<T> {
        this.mutex.acquireUninterruptibly();
        if (this.closed) {
            this.mutex.release();
            throw new TaskGroupClosedError("cannot spawn after TaskGroup.close");
        }
        var future: Future<T> = new Future<T>();
        var erased: Future<any> = cast future as Future<any>;
        // children 的追加顺序就是子任务创建顺序；close 按同一顺序聚合 primary，
        // 因此这里不再另存一份序列号，避免两份顺序来源漂移。
        this.children.add(erased);
        var token: CancellationToken = this.rootToken.createChild();
        if (deadline != null) {
            // 检查器的空值收窄不作用于实参位置，判空后显式转换。
            token.restrictDeadline(cast deadline as Deadline);
        }
        this.mutex.release();

        var runner: TaskRunner<T> = new TaskRunner<T>(this, body, future, token);
        try {
            executor.schedule(runner);
        } catch (rejected: java.lang.Throwable) {
            // 调度拒绝是「任务从未开始」的失败：Future 必须先进入终态，再标记 settled，
            // 否则 close 会等待一个永远不会运行的执行体。
            var failure: Failure = new Failure(rejected.toString(), "schedule");
            try {
                future.fail(failure);
            } finally {
                try {
                    this.onChildFailure();
                } finally {
                    future.markTaskSettled();
                }
            }
        }
        return future;
    }

    /**
     * 做什么：把编译器生成的协程帧作为子任务登记并启动；帧只继承作用域截止点。
     * 什么时候用：S4-C 生成帧需要随作用域一起 join、级联取消与聚合失败时。
     * 前置条件 / 失败模式：同 launchWithin。
     */
    public function launch<T>(task: CoroutineTask<T>): Future<T> {
        return this.launchWithin(task, null);
    }

    /**
     * 做什么：登记并启动一个带显式截止点的生成帧；有效截止点 = min(作用域截止点, deadline)。
     * 什么时候用：某个协程子任务需要比作用域更严格的期限时（契约 §6 ChildOptions.deadline）。
     * 前置条件：同 launch；deadline 非 null。
     * 失败模式：同 launch；到期时帧在下一个检查点（分派入口或挂起点入口）以 Deadline 取消
     *   自己的结果，不执行其后的业务段；子任务自身到期不触发普通组兄弟级联。
     * 为什么显式期限不能放宽：同 spawnWithDeadline，子令牌只能收紧。
     */
    public function launchWithDeadline<T>(task: CoroutineTask<T>, deadline: Deadline): Future<T> {
        return this.launchWithin(task, deadline);
    }

    /**
     * 做什么：launch / launchWithDeadline 的共同实现；deadline 为 null 表示只继承作用域截止点。
     * 前置条件：task 尚未 start，其结果 Future 只属于这一个帧且仍为 Pending；
     *   帧负责在结果终态后（含被作用域取消）调用 markTaskSettled。
     * 失败模式：关闭后抛 TaskGroupClosedError，帧不会启动；执行器拒绝首次恢复时
     *   返回已失败且已 settled 的 Future，并按普通组语义取消兄弟。
     * 为什么先登记再挂接再启动：close 必须能看到每个已启动帧；失败级联回调必须在
     *   帧可能发布失败之前注册，否则早到的失败会漏掉兄弟取消。
     * 为什么用结果 Future 的回调做级联：帧的失败在恢复段内发布，不存在 TaskRunner
     *   那样包住整个执行体的 finally；Future 终态回调恰好覆盖所有失败发布路径。
     * 为什么给帧一个根令牌的子令牌：帧在检查点上用它观察作用域与自身的截止点；令牌取消
     *   （作用域到期被任一检查点观察、显式取消、兄弟失败）经 ScopeCancellationRelay 以首个原因
     *   取消结果 Future，挂起中的帧由结果回调唤醒并回收。只靠 cancelBecause 的快照不够：
     *   别处检查点发现作用域到期时只取消根令牌，不经过 cancelBecause。
     * 为什么子令牌在锁内派生：与 spawnWithin 相同，cancel 先取消根令牌再在锁内快照子任务；
     *   派生时根已取消则子令牌立即取消，之后取消则经根的回调传播，两边不会都漏掉。
     */
    public function launchWithin<T>(task: CoroutineTask<T>, deadline: Deadline?): Future<T> {
        var future: Future<T> = task.resultFuture();
        var erased: Future<any> = cast future as Future<any>;
        // 登记帧是检查点：作用域已到期则先以 Deadline 取消根令牌，派生的子令牌随之已取消。
        // 放在锁外：到期取消会同步执行根令牌回调。
        this.rootToken.pollDeadline();
        this.mutex.acquireUninterruptibly();
        if (this.closed) {
            this.mutex.release();
            throw new TaskGroupClosedError("cannot launch after TaskGroup.close");
        }
        this.children.add(erased);
        var token: CancellationToken = this.rootToken.createChild();
        if (deadline != null) {
            token.restrictDeadline(cast deadline as Deadline);
        }
        this.mutex.release();

        erased.onComplete(new ChildFailureRelay(this));
        task.bindToken(token);
        // 已取消（显式取消、普通组失败级联或已观察到的到期）的作用域里新帧不执行任何业务段：
        // 子令牌派生时已取消，下面的注册立即以根令牌的首个原因发布 Cancelled，start 后帧在
        // 入口检查处直接回收，与 spawn 的令牌语义一致。
        token.onCancel(new ScopeCancellationRelay(erased));
        try {
            task.start();
        } catch (rejected: java.lang.Throwable) {
            // 生成帧的调度门已为绑定结果发布失败并标记 settled；这里再兜底一次，
            // 保证任何 CoroutineTask 实现都不会留下 close 永远等待的子任务。
            try {
                future.fail(new Failure(rejected.toString(), "schedule"));
            } finally {
                future.markTaskSettled();
            }
        }
        return future;
    }

    /**
     * 做什么：关闭作用域、等待全部子任务执行体退出，并按策略聚合失败。
     * 什么时候用：作用域正常结束或异常退出前的 finally 中。
     * 前置条件：调用方接受等待已经启动的子任务；不可中断的外部阻塞可能让 close 阻塞。
     * 失败模式：未处理失败抛 TaskGroupFailure，仅有取消抛 CancellationException；首次聚合冻结。
     *   CancellationException 的原因：作用域根令牌已取消时取其首个原因；否则取创建序最早的
     *   已取消子任务的原因（子任务被单独取消），与 primary 的确定性顺序规则一致。
     * 为什么先复制子任务列表：等待期间不持锁，允许任务完成回调正常推进，也避免
     *   把长阻塞放进临界区。
     */
    public function close(): void {
        this.mutex.acquireUninterruptibly();
        this.closed = true;
        var snapshot: MutableList<Future<any>> = new MutableList<Future<any>>();
        for (child in this.children) {
            snapshot.add(child);
        }
        this.mutex.release();

        for (child in snapshot) {
            child.awaitTaskSettled();
        }

        this.mutex.acquireUninterruptibly();
        if (!this.aggregationDone) {
            this.aggregationDone = true;
            var primary: Failure? = null;
            var suppressed: int32 = 0;
            var cancelled: bool = this.rootToken.isCancelled();
            var reason: CancellationReason = this.rootToken.reasonOr(CancellationReason.Explicit);
            for (child in snapshot) {
                if (child.status() == FutureStatus.Cancelled && !cancelled) {
                    cancelled = true;
                    reason = child.cancellationReasonOr(reason);
                }
                var failure: Failure? = child.failureOrNull();
                if (failure == null) {
                    continue;
                }
                // 只有监督组承认「已确认」；普通组的子失败仍进入聚合，
                // 因为普通组的兄弟取消策略不因确认而改变。
                if (this.supervisorScope && child.isFailureAcknowledged()) {
                    continue;
                }
                if (primary == null) {
                    primary = failure;
                } else {
                    suppressed = suppressed + 1;
                }
            }
            this.aggregatePrimary = primary;
            this.aggregateSuppressed = suppressed;
            this.aggregateCancelled = cancelled;
            this.aggregateReason = reason;
        }
        var decided: Failure? = this.aggregatePrimary;
        var decidedSuppressed: int32 = this.aggregateSuppressed;
        var decidedCancelled: bool = this.aggregateCancelled;
        var decidedReason: CancellationReason = this.aggregateReason;
        this.mutex.release();

        if (decided == null) {
            if (decidedCancelled) {
                throw new CancellationException("TaskGroup cancelled", decidedReason);
            }
            return;
        }
        var message: string = decided.message();
        if (decidedSuppressed > 0) {
            message = message + " (+" + decidedSuppressed + " suppressed)";
        }
        throw new TaskGroupFailure(message, decidedSuppressed);
    }

    /**
     * 做什么：把作用域截止点收紧为 min(当前, deadline)；已创建与之后创建的子任务都受其约束。
     * 什么时候用：进入作用域后设定期限（契约 §2：作用域设定 Deadline）。
     * 前置条件：deadline 非 null。
     * 失败模式：不会失败；更晚的 deadline 不改变任何东西。
     * 为什么不立即取消：到期只在检查点观察；子令牌经父引用实时看到收紧后的期限。
     */
    public function restrictDeadline(deadline: Deadline): void {
        this.rootToken.restrictDeadline(deadline);
    }

    /** 做什么：返回作用域有效截止点；未设定时返回 null。前置条件：无；失败模式：不会失败。 */
    public function deadline(): Deadline? {
        return this.rootToken.deadline();
    }

    /**
     * 做什么：以 Explicit 原因主动取消根令牌与全部未终态子任务。
     * 什么时候用：父作用域异常或调用方提前放弃时。
     * 前置条件：无。
     * 失败模式：同 cancelBecause。
     */
    public function cancel(): void {
        this.cancelBecause(CancellationReason.Explicit);
    }

    /**
     * 做什么：以指定原因取消根令牌与全部未终态子任务。
     * 什么时候用：cancel（Explicit）与普通组首个失败级联（SiblingFailed）。
     * 前置条件：reason 非 null。
     * 失败模式：通知全部尝试后汇总回调错误；取消不代表执行体已退出，仍应 close join。
     * 为什么同时取消根令牌与 Future：令牌负责协作检查，Future 负责让等待者立即
     *   观察到取消；两者都由同一取消请求驱动，不互相替代。
     * 为什么子任务用根令牌的原因而不是传入原因：作用域只有一个取消原因——根令牌的首个
     *   原因。两个取消源并发时（如显式取消与兄弟失败级联），后到者对根是空操作，若仍把自己
     *   的原因写进尚未终态的子 Future，同一子任务的令牌（经 createChild 沿用根原因）与结果
     *   会报告不同原因。读根令牌之后再写子任务，保证二者一致。
     */
    private function cancelBecause(reason: CancellationReason): void {
        var callbackFailures: int32 = 0;
        var firstFailure: string = "";
        try {
            this.rootToken.cancelWith(reason);
        } catch (error: java.lang.Throwable) {
            firstFailure = error.toString();
            callbackFailures = callbackFailures + 1;
        }
        // 根令牌此时必已取消（cancelWith 先置位再回调，回调失败也不回滚），reasonOr 的回退不可达。
        var effective: CancellationReason = this.rootToken.reasonOr(reason);
        var snapshot: MutableList<Future<any>> = new MutableList<Future<any>>();
        this.mutex.acquireUninterruptibly();
        for (child in this.children) {
            snapshot.add(child);
        }
        this.mutex.release();
        for (child in snapshot) {
            try {
                child.cancelWith(effective);
            } catch (error: java.lang.Throwable) {
                if (callbackFailures == 0) { firstFailure = error.toString(); }
                callbackFailures = callbackFailures + 1;
            }
        }
        if (callbackFailures > 0) {
            throw new CallbackDispatchError(firstFailure, callbackFailures);
        }
    }

    /**
     * 做什么：普通组子任务首次失败后的级联反应。
     * 什么时候用：TaskRunner 成功发布失败终态且当前不是监督组时。
     * 前置条件：失败已经写入对应 Future。
     * 失败模式：取消回调失败时抛 CallbackDispatchError，全部兄弟仍会收到取消。
     * 为什么只对普通组生效：监督组按裁决不因一个子失败取消兄弟。
     */
    public function onChildFailure(): void {
        // 公开原因：Jasper 当前没有包内可见性，TaskRunner 需要调用本方法。它仍只服务
        // 运行时内部，文档明确调用方不应直接使用。
        if (this.supervisorScope) {
            return;
        }
        this.cancelBecause(CancellationReason.SiblingFailed);
    }
}

/**
 * 协程子任务的失败级联回调。
 *
 * 做什么：结果 Future 进入 Failed 时通知所属作用域；成功与取消不触发级联。
 * 什么时候用：TaskGroup.launch 在启动帧之前注册到结果 Future。
 * 前置条件：owner 非 null。
 * 失败模式：兄弟取消回调失败时抛 CallbackDispatchError，由 Future 的批次通知汇总。
 * 为什么取消不级联：取消是独立终态（见 TaskRunner.run），由作用域取消自身发起时
 *   再级联只会重复取消；业务失败才需要普通组取消兄弟。
 */
public class ChildFailureRelay implements Action<FutureOutcome> {
    private var owner: TaskGroup;

    /** 做什么：绑定所属作用域。前置条件：owner 非 null；失败模式：不会失败。 */
    public constructor(owner: TaskGroup) {
        this.owner = owner;
    }

    /** 做什么：失败终态时触发 onChildFailure。前置条件：snapshot 为终态快照。 */
    public function accept(snapshot: FutureOutcome): void {
        if (snapshot.isFailed()) {
            this.owner.onChildFailure();
        }
    }
}

/**
 * 协程子任务令牌到结果的取消传播。
 *
 * 做什么：作为 Action<CancellationToken> 注册到生成帧的子令牌，令牌取消时以其首个原因取消
 *   帧的结果 Future；结果已终态时为空操作。
 * 什么时候用：TaskGroup.launchWithin 在启动帧之前注册。
 * 前置条件：future 是该帧的结果 Future。
 * 失败模式：结果回调（帧恢复请求、失败级联）失败时抛 CallbackDispatchError，由令牌的批次汇总。
 * 为什么 fallback 写 Explicit：回调在令牌已置位之后执行，reasonOr 必返回令牌的首个原因，
 *   fallback 不可达；Explicit 与 cancel() 的默认一致。
 */
public class ScopeCancellationRelay implements Action<CancellationToken> {
    private var future: Future<any>;

    /** 做什么：绑定要取消的结果 Future。前置条件：future 非 null；失败模式：不会失败。 */
    public constructor(future: Future<any>) {
        this.future = future;
    }

    /** 做什么：令牌取消时以其首个原因取消结果。前置条件：token 已取消。 */
    public function accept(token: CancellationToken): void {
        this.future.cancelWith(token.reasonOr(CancellationReason.Explicit));
    }
}

/**
 * 子任务执行体包装器。
 *
 * 做什么：把 TaskBody 适配为 Executor 需要的 Runnable，并把返回值/失败/取消统一
 *   发布到 Future，最后无条件标记任务体已退出。
 * 什么时候用：TaskGroup.spawn 内部创建，每次 spawn 一个新实例。
 * 前置条件：owner/future/token 由同一个 TaskGroup.spawn 创建并配对。
 * 失败模式：执行体异常被转换为 Failure；Future 已取消时 fail/complete 返回 false
 *   且不会二次发布终态。
 * 为什么用具体类而不是 lambda：Runnable 继承平台接口，当前编译器只为纯 Jasper
 *   单方法接口生成 lambda 目标；具体类还能把「finally 必标记 settled」集中到一处。
 */
public class TaskRunner<T> implements Runnable {
    private var owner: TaskGroup;
    private var body: TaskBody<T>;
    private var future: Future<T>;
    private var token: CancellationToken;

    /**
     * 做什么：绑定一次子任务执行所需的全部引用。
     * 什么时候用：TaskGroup.spawn 内。
     * 前置条件：四个引用非 null。
     * 失败模式：不会失败。
     * 为什么全部用构造器注入：执行期间不再改绑，避免读到另一个任务的状态。
     */
    public constructor(owner: TaskGroup, body: TaskBody<T>, future: Future<T>, token: CancellationToken) {
        this.owner = owner;
        this.body = body;
        this.future = future;
        this.token = token;
    }

    /**
     * 做什么：执行任务体并发布终态。
     * 什么时候用：执行器线程调用一次。
     * 前置条件：Future 初始为 Pending。
     * 失败模式：CancellationException 发布 Cancelled；业务 Error 与平台 Throwable 转成 Failure；finally
     *   都会标记 settled，保证作用域关闭不会漏 join。
     * 为什么先看令牌再看返回值：执行体可能在取消后仍正常返回一个值，此时可观察语义
     *   必须是 Cancelled，而不是把迟到结果伪装成成功。
     * 为什么用嵌套 try 而不是并列 catch：当前编译器只为「每个 try 的第一个 catch」
     *   生成异常表项，并列写 Error + Throwable 会让第二个 catch 从空栈执行 ASTORE 而
     *   在字节码帧合并阶段失败；外层 try 覆盖内层 catch 体，语义等价且只用一个处理器。
     */
    public function run(): void {
        try {
            try {
                try {
                    // 任务体开始前是首个检查点：父期限已过的子任务在此取消（契约 §10），
                    // 任务体随后用 isCancelled 也能观察到。到期取消不抛异常、不跳过任务体，
                    // 与「已取消作用域中 spawn 的任务体照常运行并自行观察」一致。
                    this.token.pollDeadline();
                    var value: T = this.body.run(this.token);
                    if (this.token.isCancelled()) {
                        this.future.cancelWith(this.token.reasonOr(CancellationReason.Explicit));
                    } else {
                        this.future.complete(value);
                    }
                } catch (cancelled: CancellationException) {
                    // 取消是独立终态，不写业务 Failure，也不触发兄弟失败级联；原因取自异常本身。
                    this.future.cancelWith(cancelled.reason());
                }
            } catch (error: Error) {
                var failure: Failure = new Failure(error.message(), "error");
                this.future.fail(failure);
            }
        } catch (throwable: java.lang.Throwable) {
            var failure: Failure = new Failure(throwable.toString(), "platform");
            this.future.fail(failure);
        } finally {
            try {
                if (this.future.status() == FutureStatus.Failed) {
                    this.owner.onChildFailure();
                }
            } finally {
                this.future.markTaskSettled();
            }
        }
    }
}
