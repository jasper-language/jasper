package std;

// S4-C 内部调度门：生成段负责业务成功/取消，本类串行恢复并补充调度和段异常结果。
// Executor 必须入队执行，不能同步递归调用 run；JvmExecutor 满足此约束。
/**
 * 同一 continuation 最多一个执行段正在运行。运行中的唤醒合并为一次后续入队，
 * 空闲时的唤醒合并为一次调度；finish 后不再执行。锁外调用执行器与业务段。
 * 这是内部实现接口，不声明新的源语言标记，也不实现 await 状态机变换。
 */
public class ContinuationDispatch implements Runnable {
    private var executor: Executor;
    private var segment: Runnable;
    private var mutex: java.util.concurrent.Semaphore;
    private var queued: bool;
    private var running: bool;
    private var wakePending: bool;
    private var finished: bool;
    private var everStarted: bool;
    private var result: Future<any>?;

    /** 绑定调度器与单步执行段；两者非 null，执行段自行保存程序位置与局部变量。 */
    public constructor(executor: Executor, segment: Runnable) {
        this.executor = executor;
        this.segment = segment;
        this.mutex = new java.util.concurrent.Semaphore(1);
        this.queued = false;
        this.running = false;
        this.wakePending = false;
        this.finished = false;
        this.everStarted = false;
        this.result = null;
    }

    /** 生成任务桥可在首次 resume 前绑定结果；重复绑定或启动后绑定均明确拒绝。 */
    public function bindResult<T>(result: Future<T>): void {
        this.mutex.acquireUninterruptibly();
        if (this.everStarted || this.finished || this.result != null) {
            this.mutex.release();
            throw new Error("continuation result must be bound once before start");
        }
        this.result = cast result as Future<any>;
        this.mutex.release();
    }

    /** 请求恢复；已终止返回 false，否则合并请求并在必要时入队，拒绝调度原样抛出。 */
    public function resume(): bool {
        this.mutex.acquireUninterruptibly();
        if (this.finished) {
            this.mutex.release();
            return false;
        }
        this.everStarted = true;
        if (this.running) {
            this.wakePending = true;
            this.mutex.release();
            return true;
        }
        if (this.queued) {
            this.mutex.release();
            return true;
        }
        this.queued = true;
        this.mutex.release();
        this.enqueue();
        return true;
    }

    /** 标记执行状态终止；已入队的陈旧恢复请求只会空返回，不强制停止正在执行的段。 */
    public function finish(): void {
        this.mutex.acquireUninterruptibly();
        this.finished = true;
        this.wakePending = false;
        this.queued = false;
        this.mutex.release();
    }

    /** 执行一个就绪段；通知回调只调用 resume，不直接执行此段。段抛错后禁止重放。 */
    public function run(): void {
        this.mutex.acquireUninterruptibly();
        if (this.finished || this.running || !this.queued) {
            this.mutex.release();
            return;
        }
        this.queued = false;
        this.running = true;
        this.mutex.release();
        try {
            this.segment.run();
        } catch (error: java.lang.Throwable) {
            this.finish();
            this.publishFailure(new Failure(error.toString(), "platform"));
            throw error;
        } finally {
            this.mutex.acquireUninterruptibly();
            this.running = false;
            var scheduleAgain: bool = this.wakePending && !this.finished;
            this.wakePending = false;
            if (scheduleAgain) { this.queued = true; }
            this.mutex.release();
            if (scheduleAgain) { this.enqueue(); }
        }
    }

    /** 锁外提交；拒绝后关闭调度门，已绑定结果补充失败与回收，然后传播异常。 */
    private function enqueue(): void {
        try {
            this.executor.schedule(this);
        } catch (error: java.lang.Throwable) {
            this.finish();
            this.publishFailure(new Failure(error.toString(), "schedule"));
            throw error;
        }
    }

    /** 调度或执行失败不能遗留 Pending 结果；通知异常也不得跳过 settled。 */
    private function publishFailure(failure: Failure): void {
        var bound: Future<any>? = this.result;
        if (bound != null) {
            var target: Future<any> = cast bound as Future<any>;
            try {
                target.fail(failure);
            } finally {
                target.markTaskSettled();
            }
        }
    }
}
