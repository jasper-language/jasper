package std;

// ============================================================================
// DeadlineTimer.jas —— 截止点计时唤醒（作用域拥有的检查点线程）
// ============================================================================
// 职责：
//   让截止点到期在没有任何其他检查点时也被观察：登记（arm）一个「令牌 + 截止点」，
//   到期时在计时线程上对该令牌执行一次检查点 pollReasonAt(now)。检查点以 Deadline 原因取消
//   到期的令牌（或帮助传播祖先的首个原因），再经既有回调传给全部后代——挂起中的生成帧经
//   ScopeCancellationRelay 被唤醒，阻塞调用经其 onCancel 回调被唤醒。计时器本身不改任何
//   取消语义：它只是「在到期时刻自动运行的检查点」，首因稳定、先父后己等规则全部来自令牌。
//
// 线程模型：
//   最多一个计时线程；没有登记项时线程退出，下次登记再启动，作用域不用时不占线程。
//   「线程退出」与「新登记」在同一把锁下判定：线程只在锁内看到登记表为空时置 running=false
//   并退出，登记在同一把锁下看到 running=false 就启动新线程，因此不会出现登记项无人服务。
//   线程等待用 wakeup 信号量的限时 tryAcquire：新登记与撤销都 release 一次，让线程重算最早
//   截止点；多余的许可只会多一次空转，不会漏唤醒。
//
// 宿主驱动模式：
//   threaded = false 时从不启动线程，由宿主（确定性测试、未来的 OS 事件循环）在自己的时刻调用
//   fireDueAt(now)。登记、撤销、到期判定与线程模式共用同一份代码。
//
// 资源：
//   登记项随令牌取消（TimerDisarm 回调）或 shutdown 撤销；撤销项在下一次 fireDueAt 时移出。
//   登记表为线性表、每次扫描 O(n)：作用域内带期限的令牌数量小，堆结构留给有负载证据之后。
// ============================================================================

/**
 * 一个登记项：到期时对 token 执行一次检查点。
 *
 * 做什么：保存令牌、截止点与是否仍有效。
 * 什么时候用：DeadlineTimer 内部使用。
 * 前置条件：token 与 deadline 非 null。
 * 失败模式：不会失败。
 * 为什么 armed 由计时器的锁保护：撤销与到期判定必须线性化，同一项最多触发一次。
 */
public class TimerEntry {
    private var tokenValue: CancellationToken;
    private var deadlineValue: Deadline;
    private var armedValue: bool;

    /** 做什么：创建有效的登记项。前置条件：参数非 null；失败模式：不会失败。 */
    public constructor(token: CancellationToken, deadline: Deadline) {
        this.tokenValue = token;
        this.deadlineValue = deadline;
        this.armedValue = true;
    }

    /** 做什么：返回要检查的令牌。前置条件：无；失败模式：不会失败。 */
    public function token(): CancellationToken {
        return this.tokenValue;
    }

    /** 做什么：返回触发时刻。前置条件：无；失败模式：不会失败。 */
    public function deadline(): Deadline {
        return this.deadlineValue;
    }

    /** 做什么：是否仍有效。前置条件：调用方持有计时器的锁；失败模式：不会失败。 */
    public function isArmed(): bool {
        return this.armedValue;
    }

    /** 做什么：标记失效。前置条件：调用方持有计时器的锁；失败模式：不会失败。 */
    public function disarm(): void {
        this.armedValue = false;
    }
}

/**
 * 截止点计时器。
 *
 * 做什么：登记「令牌 + 截止点」，到期时在计时线程（或宿主调用 fireDueAt 时）对令牌执行检查点。
 * 什么时候用：TaskGroup 为作用域截止点与子任务 / 生成帧的显式截止点登记。
 * 前置条件：无。
 * 失败模式：线程启动失败时 arm 以平台异常传播，登记项保留、下次 arm 重试启动；检查点回调失败
 *   在计时线程上计数（callbackFailureCount），取消状态已由令牌置位、不回滚。
 * 为什么不直接给令牌加计时：令牌是纯状态机、被检查点在任意线程调用；线程与生命周期属于作用域，
 *   作用域 close 时 shutdown 收回，计时器不会比作用域活得更久。
 */
public class DeadlineTimer {
    private var mutex: java.util.concurrent.Semaphore;
    private var wakeup: java.util.concurrent.Semaphore;
    private var entries: MutableList<TimerEntry>;
    private var threaded: bool;
    private var running: bool;
    private var stopped: bool;
    private var threadsStarted: int32;
    private var firedTotal: int32;
    private var callbackFailures: int32;

    /**
     * 做什么：创建计时器；threaded 为 false 时进入宿主驱动模式（从不启动线程）。
     * 前置条件：无。
     * 失败模式：信号量分配失败时以平台异常出现。
     * 为什么构造时不启动线程：没有登记项时不占线程。
     */
    public constructor(threaded: bool) {
        this.mutex = new java.util.concurrent.Semaphore(1);
        this.wakeup = new java.util.concurrent.Semaphore(0);
        this.entries = new MutableList<TimerEntry>();
        this.threaded = threaded;
        this.running = false;
        this.stopped = false;
        this.threadsStarted = 0;
        this.firedTotal = 0;
        this.callbackFailures = 0;
    }

    /**
     * 做什么：登记在 deadline 到期时对 token 执行检查点；token 取消时登记自动撤销。
     * 什么时候用：设定或收紧作用域 / 子任务期限之后。
     * 前置条件：token 的自身截止点已收紧到不晚于 deadline（否则触发时检查点不会判到期，只是空检查）。
     * 失败模式：shutdown 之后登记为空操作；线程启动失败抛平台异常（见类注释）。
     * 为什么先注册撤销回调再入表：令牌已取消时 onCancel 立即撤销这一项，入表时看到已撤销就不入表，
     *   已取消令牌的登记从不对 fireDueAt 可见。反过来的顺序（先入表）留下一个窗口：并发的 fireDueAt
     *   会把已取消令牌的项当作到期项触发并返回 0（Lincheck 发现的不可线性化结果，见
     *   DeadlineTimerLincheckTest）。入表之后才取消的令牌照常由回调撤销。
     */
    public function arm(token: CancellationToken, deadline: Deadline): void {
        var entry: TimerEntry = new TimerEntry(token, deadline);
        token.onCancel(new TimerDisarm(this, entry));
        this.mutex.acquireUninterruptibly();
        if (this.stopped || !entry.isArmed()) {
            this.mutex.release();
            return;
        }
        this.entries.add(entry);
        var startThread: bool = false;
        if (this.threaded && !this.running) {
            this.running = true;
            this.threadsStarted = this.threadsStarted + 1;
            startThread = true;
        }
        this.mutex.release();
        if (startThread) {
            this.startLoop();
        } else {
            this.wakeup.release();
        }
    }

    /**
     * 做什么：启动计时线程（守护线程）。
     * 前置条件：调用方刚在锁内把 running 置为 true。
     * 失败模式：线程创建 / 启动失败时把 running 复位后重新抛出，下一次 arm 会重试。
     * 为什么守护线程：计时线程只服务取消，不应单独让宿主进程无法退出；作用域 close 时
     *   shutdown 本就会让它退出。
     * 为什么公开：Jasper 当前没有包内可见性；调用方不应直接使用。
     */
    public function startLoop(): void {
        try {
            var loop: java.lang.Runnable = new TimerLoop(this);
            var thread: java.lang.Thread = new java.lang.Thread(loop, "jasper-deadline-timer");
            thread.setDaemon(true);
            thread.start();
        } catch (error: java.lang.Throwable) {
            this.mutex.acquireUninterruptibly();
            this.running = false;
            this.mutex.release();
            throw error;
        }
    }

    /**
     * 做什么：计时线程主循环：反复触发到期项，并限时等待下一个截止点或唤醒信号。
     * 什么时候用：仅 TimerLoop.run 调用。
     * 前置条件：本线程是唯一的计时线程（running 由本线程持有）。
     * 失败模式：不抛出；等待被中断时重新计算。
     * 为什么每轮重读时钟：限时等待可能提前返回（唤醒信号、虚假唤醒），到期判定总以当时时刻为准。
     */
    public function runLoop(): void {
        var unit: java.util.concurrent.TimeUnit = java.util.concurrent.TimeUnit.valueOf("NANOSECONDS");
        while (true) {
            var now: int64 = java.lang.System.nanoTime();
            var waitNanos: int64 = this.fireDueAt(now);
            if (java.lang.Long.compare(waitNanos, 0) < 0) {
                return;
            }
            if (java.lang.Long.compare(waitNanos, 0) > 0) {
                try {
                    this.wakeup.tryAcquire(waitNanos, unit);
                } catch (interrupted: java.lang.InterruptedException) {
                }
            }
        }
    }

    /**
     * 做什么：在单调时刻 nowNanos 触发全部已到期的有效登记项（每项恰好一次），移出已撤销项；
     *   返回下一次需要等待的纳秒数：0 表示应立即再检查一次，正数为距最早截止点的时长，
     *   -1 表示登记表已空（线程模式下本线程应退出，running 已在锁内复位）。
     * 什么时候用：计时线程每轮；宿主驱动模式下由宿主在自己的时刻调用。
     * 前置条件：同一时刻只有一个调用者——线程模式下只由计时线程调用，宿主驱动模式下由宿主的单个
     *   驱动者调用。两个调用者并发时各自的快照可能各取到一部分到期项，单项仍至多触发一次，但「一次调用
     *   取出全部到期项」不再成立（Lincheck 以不可线性化结果复现）。
     * 失败模式：不抛出；检查点回调失败计入 callbackFailureCount。
     * 为什么在锁外执行检查点：检查点会同步执行令牌回调（唤醒帧、撤销登记项），撤销回调要拿本锁。
     * 为什么快照时再查令牌是否已取消：令牌在置位之后才执行回调，取消返回后撤销回调可能仍在取消者线程上
     *   排队；只靠回调撤销，紧随取消的一次 fireDueAt 会把已取消令牌的项当作到期项（Lincheck 复现）。
     *   锁序为计时器 → 令牌；令牌从不在持锁时调用计时器（回调都在释放令牌锁之后执行），不会死锁。
     * 为什么触发后返回 0：回调可能耗时、也可能登记了新项，重读时钟再算比沿用旧时刻安全。
     */
    public function fireDueAt(nowNanos: int64): int64 {
        var due: MutableList<TimerEntry> = new MutableList<TimerEntry>();
        var remaining: MutableList<TimerEntry> = new MutableList<TimerEntry>();
        var earliest: Deadline? = null;
        this.mutex.acquireUninterruptibly();
        for (entry in this.entries) {
            if (!entry.isArmed()) {
                continue;
            }
            // 令牌已取消、撤销回调尚未执行（取消在置位之后才在取消者线程上逐个执行回调）：视同已撤销。
            if (entry.token().isCancelled()) {
                entry.disarm();
                continue;
            }
            if (entry.deadline().isExpiredAt(nowNanos)) {
                entry.disarm();
                due.add(entry);
            } else {
                remaining.add(entry);
                earliest = Deadline.earliest(earliest, entry.deadline());
            }
        }
        this.entries = remaining;
        var exit: bool = false;
        if (due.size() == 0 && remaining.size() == 0) {
            this.running = false;
            exit = true;
        }
        this.mutex.release();

        var failures: int32 = 0;
        for (entry in due) {
            try {
                entry.token().pollReasonAt(nowNanos);
            } catch (error: java.lang.Throwable) {
                failures = failures + 1;
            }
        }
        this.mutex.acquireUninterruptibly();
        this.firedTotal = this.firedTotal + due.size();
        this.callbackFailures = this.callbackFailures + failures;
        this.mutex.release();

        if (exit) {
            return -1L;
        }
        if (due.size() > 0) {
            return 0L;
        }
        var next: Deadline = cast earliest as Deadline;
        return next.remainingNanosAt(nowNanos);
    }

    /**
     * 做什么：撤销一个登记项，并唤醒计时线程重算（登记表可能因此变空、线程得以退出）。
     * 什么时候用：TimerDisarm 在令牌取消时调用。
     * 前置条件：entry 由本计时器 arm 创建。
     * 失败模式：不会失败；已触发或已撤销的项再撤销为空操作。
     * 为什么公开：Jasper 当前没有包内可见性；调用方不应直接使用。
     */
    public function disarm(entry: TimerEntry): void {
        this.mutex.acquireUninterruptibly();
        entry.disarm();
        this.mutex.release();
        this.wakeup.release();
    }

    /**
     * 做什么：撤销全部登记项并拒绝之后的登记；计时线程在下一轮看到空表后退出。
     * 什么时候用：TaskGroup.close 在全部子任务 settled 之后。
     * 前置条件：无。
     * 失败模式：不会失败；重复调用幂等。
     * 为什么 close 之后不再需要计时：作用域内已无未 settled 的任务，到期不再有可唤醒的对象。
     */
    public function shutdown(): void {
        this.mutex.acquireUninterruptibly();
        this.stopped = true;
        for (entry in this.entries) {
            entry.disarm();
        }
        this.mutex.release();
        this.wakeup.release();
    }

    /** 做什么：返回有效登记项数。前置条件：无；失败模式：不会失败。 */
    public function armedCount(): int32 {
        this.mutex.acquireUninterruptibly();
        var count: int32 = 0;
        for (entry in this.entries) {
            if (entry.isArmed()) {
                count = count + 1;
            }
        }
        this.mutex.release();
        return count;
    }

    /** 做什么：计时线程是否在运行（或正在启动）。前置条件：无；失败模式：不会失败。 */
    public function isRunning(): bool {
        this.mutex.acquireUninterruptibly();
        var result: bool = this.running;
        this.mutex.release();
        return result;
    }

    /** 做什么：累计启动过的计时线程数。前置条件：无；失败模式：不会失败。 */
    public function threadsStartedCount(): int32 {
        this.mutex.acquireUninterruptibly();
        var result: int32 = this.threadsStarted;
        this.mutex.release();
        return result;
    }

    /** 做什么：累计触发的登记项数。前置条件：无；失败模式：不会失败。 */
    public function firedCount(): int32 {
        this.mutex.acquireUninterruptibly();
        var result: int32 = this.firedTotal;
        this.mutex.release();
        return result;
    }

    /** 做什么：累计检查点回调失败次数。前置条件：无；失败模式：不会失败。 */
    public function callbackFailureCount(): int32 {
        this.mutex.acquireUninterruptibly();
        var result: int32 = this.callbackFailures;
        this.mutex.release();
        return result;
    }
}

/**
 * 计时线程体。
 *
 * 做什么：在新线程上运行 DeadlineTimer.runLoop。
 * 什么时候用：DeadlineTimer.startLoop 内部使用。
 * 前置条件：timer 非 null。
 * 失败模式：runLoop 不抛出。
 */
public class TimerLoop implements Runnable {
    private var timer: DeadlineTimer;

    /** 做什么：绑定计时器。前置条件：timer 非 null；失败模式：不会失败。 */
    public constructor(timer: DeadlineTimer) {
        this.timer = timer;
    }

    /** 做什么：运行计时主循环直到登记表为空。前置条件：无；失败模式：不会失败。 */
    public function run(): void {
        this.timer.runLoop();
    }
}

/**
 * 令牌取消时撤销登记项。
 *
 * 做什么：作为 Action<CancellationToken> 注册到被登记的令牌上。
 * 什么时候用：DeadlineTimer.arm 内部使用。
 * 前置条件：timer、entry 非 null。
 * 失败模式：不会失败。
 * 为什么撤销：令牌已取消后检查点只会返回既有原因，留着登记项只会让线程多等一次。
 */
public class TimerDisarm implements Action<CancellationToken> {
    private var timer: DeadlineTimer;
    private var entry: TimerEntry;

    /** 做什么：绑定计时器与登记项。前置条件：参数非 null；失败模式：不会失败。 */
    public constructor(timer: DeadlineTimer, entry: TimerEntry) {
        this.timer = timer;
        this.entry = entry;
    }

    /** 做什么：撤销登记项。前置条件：无；失败模式：不会失败。 */
    public function accept(token: CancellationToken): void {
        this.timer.disarm(this.entry);
    }
}
